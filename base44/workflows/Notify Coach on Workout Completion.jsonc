{
  "name": "Notify Coach on Workout Completion",
  "description": "Sends an in-app notification and email to all admin coaches whenever a client logs a completed workout session.",
  "trigger": {
    "condition": "${ ((.trigger.data.status == \"completed\") and (.trigger.changed_fields | index(\"status\") != null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "WorkoutSession"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notify_coach_on_workout_completion",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "onWorkoutCompleted",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "onWorkoutCompleted"
  }
}