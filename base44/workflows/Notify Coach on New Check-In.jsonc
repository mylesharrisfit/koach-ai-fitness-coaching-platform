{
  "name": "Notify Coach on New Check-In",
  "description": "",
  "trigger": {
    "condition": "${ (.trigger.data.review_status != \"pending\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "CheckIn"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notify_coach_on_new_check_in",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "onCheckInCreated",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "onCheckInCreated"
  }
}